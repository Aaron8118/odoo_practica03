<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_esdeveniment_tree" model="ir.ui.view">
        <field name="name">esdeveniment.tree</field>
        <field name="model">venda_entrades_segures.esdeveniment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="preu_base"/>
                <field name="data_inici"/>
            </list>
        </field>
    </record>

    <record id="view_esdeveniment_form" model="ir.ui.view">
        <field name="name">esdeveniment.form</field>
        <field name="model">venda_entrades_segures.esdeveniment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="preu_base"/>
                        <field name="data_inici"/>
                    </group>

                    <notebook>
                        <page string="Entrades">
                            <field name="tiquet_ids">
                                <list>
                                    <field name="comprador_id"/>
                                    <field name="preu_final"/>
                                    <field name="codi_seguretat"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esdeveniment" model="ir.actions.act_window">
        <field name="name">Esdeveniments</field>
        <field name="res_model">venda_entrades_segures.esdeveniment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_entrades_root"
              name="Entrades Segures"/>

    <menuitem id="menu_esdeveniments"
              name="Esdeveniments"
              parent="menu_entrades_root"
              action="action_esdeveniment"/>

</odoo>
