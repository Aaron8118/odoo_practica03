<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_etiqueta_tree" model="ir.ui.view">
        <field name="name">etiqueta.tree</field>
        <field name="model">venda_entrades_segures.etiqueta</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="descripcio"/>
            </list>
        </field>
    </record>

    <record id="view_etiqueta_form" model="ir.ui.view">
        <field name="name">etiqueta.form</field>
        <field name="model">venda_entrades_segures.etiqueta</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcio"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etiqueta" model="ir.actions.act_window">
        <field name="name">Etiquetes</field>
        <field name="res_model">venda_entrades_segures.etiqueta</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_etiquetes"
              name="Etiquetes"
              parent="menu_entrades_root"
              action="action_etiqueta"/>

</odoo>
