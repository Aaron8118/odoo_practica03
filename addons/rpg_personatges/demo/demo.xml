<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================= -->
    <!-- CLASE DEL PERSONAJE               -->
    <!-- ================================= -->

    <record id="classe_guerrer" model="rpg.classe">
        <field name="name">Guerrer</field>
    </record>


    <!-- ================================= -->
    <!-- PERSONATGE PRINCIPAL              -->
    <!-- ================================= -->

    <record id="heroi_principal" model="rpg.personatge">

        <field name="name">Arthas</field>

        <!-- IMATGE -->
        <field name="imatge"
               type="base64"
               file="rpg_personatges/demo/images/hero.png"/>

        <!-- DATA ACTUAL MENYS 30 DIES -->
        <field name="data_creacio"
               eval="(datetime.datetime.now() - datetime.timedelta(days=30)).date()"/>

        <!-- MANY2ONE -->
        <field name="classe_id"
               ref="rpg_personatges.classe_guerrer"/>

        <!-- MANY2MANY -->
        <field name="habilitat_ids"
               eval="[
                   (0, 0, {
                       'name': 'Espasa',
                       'descripcio': 'Domini de l’espasa'
                   }),
                   (0, 0, {
                       'name': 'Escut',
                       'descripcio': 'Defensa amb escut'
                   }),
                   (0, 0, {
                       'name': 'Atac poderós',
                       'descripcio': 'Atac de gran força'
                   })
               ]"/>

    </record>


    <!-- ================================= -->
    <!-- AVALUADOR IMATGE                  -->
    <!-- ================================= -->

    <record id="avaluador_img" model="rpg.avaluador">
        <field name="nom_model">rpg.personatge</field>
        <field name="ext_id">rpg_personatges.heroi_principal</field>
        <field name="requisit">img</field>
    </record>


    <!-- ================================= -->
    <!-- AVALUADOR REFERENCIA              -->
    <!-- ================================= -->

    <record id="avaluador_ref" model="rpg.avaluador">
        <field name="nom_model">rpg.personatge</field>
        <field name="ext_id">rpg_personatges.heroi_principal</field>
        <field name="requisit">ref</field>
    </record>


    <!-- ================================= -->
    <!-- AVALUADOR DATA                    -->
    <!-- ================================= -->

    <record id="avaluador_dat" model="rpg.avaluador">
        <field name="nom_model">rpg.personatge</field>
        <field name="ext_id">rpg_personatges.heroi_principal</field>
        <field name="requisit">dat</field>
    </record>


    <!-- ================================= -->
    <!-- AVALUADOR MANY2MANY               -->
    <!-- ================================= -->

    <record id="avaluador_m2m" model="rpg.avaluador">
        <field name="nom_model">rpg.personatge</field>
        <field name="ext_id">rpg_personatges.heroi_principal</field>
        <field name="requisit">m2m</field>
    </record>

</odoo>
